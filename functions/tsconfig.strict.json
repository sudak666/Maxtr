{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "CommonJS",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../node_modules/@types"
    ]
  },
  "include": [
    "lib/pure.js",
    "lib/sweep.js",
    "lib/backup.js",
    "lib/account.js",
    "index.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
