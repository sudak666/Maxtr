<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup="false" does not cover device-to-device transfer on
     Android 12+ (some vendors copy app data on a phone switch). Nothing here
     should move: the Room cache, the PIN hash/lockout and the sync markers
     belong to this install; the data itself lives in Firestore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
