<?xml version="1.0" encoding="utf-8"?>
<!-- Widget header mark: the launcher icon (purple tile + Rytm calendar/trend
     glyph), zoomed so the glyph fills the small tile like the app icon does. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#7C3AED" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:bottom="-24dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:left="-24dp"
        android:right="-24dp"
        android:top="-24dp" />
</layer-list>
